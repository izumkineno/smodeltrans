      "../models/ppocrv6/medium_rec/model.safetensors": "models/ppocrv6/medium_rec/model.safetensors",
      "../models/ppocrv6/medium_rec/config.json": "models/ppocrv6/medium_rec/config.json",
      "../models/ppocrv6/medium_rec/preprocessor_config.json": "models/ppocrv6/medium_rec/preprocessor_config.json",
      "../models/ppocrv6/medium_rec/inference.yml": "models/ppocrv6/medium_rec/inference.yml"
    }
  }
}
