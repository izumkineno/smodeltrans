{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "smodeltrans",
  "version": "0.3.0",
  "identifier": "com.tauri-app.smodeltrans",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "smodeltrans - 翻译工作区",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false
      },
      {
        "label": "quick-translation",
        "title": "smodeltrans - 快捷翻译",
        "url": "index.html",
        "width": 320,
        "height": 104,
        "minWidth": 160,
        "minHeight": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
